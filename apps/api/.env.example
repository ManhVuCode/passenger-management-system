DATABASE_URL=""
# Migrate dùng kết nối trực tiếp. Dùng Supabase: DATABASE_URL = pooler 6543 (?pgbouncer=true) cho runtime,
# DIRECT_URL = session pooler/direct 5432 cho `prisma migrate`. Local thì để 2 cái giống nhau.
DIRECT_URL=""
JWT_SECRET=""
JWT_EXPIRES_IN=""
PORT=

# Queue (BullMQ) — async notification send + retry. Leave default for local docker redis.
# Redis có TLS (vd Upstash) dùng scheme rediss:// — QueueModule tự bật TLS + đọc username.
# Bỏ trống / Redis chết -> tự fallback gửi inline (enqueueOrInline), vẫn gửi được nhưng mất retry.
REDIS_URL=redis://localhost:6379

# Notification providers — leave blank for dev (mock mode: logs only, no real send)
SMS_PROVIDER=MOCK          # MOCK | ESMS | TWILIO
EMAIL_PROVIDER=MOCK        # MOCK | BREVO (free 300 email/ngày, không cần thẻ)
BREVO_API_KEY=             # https://app.brevo.com/settings/keys/api
EMAIL_FROM=                # địa chỉ sender đã verify trên Brevo
EMAIL_FROM_NAME=MPMS
SMS_API_KEY=
SMS_SECRET_KEY=
SMS_BRANDNAME=
SMS_FROM=
BROADCAST_API_KEY=
# Telegram: 1 bot / 1 nhà xe — token lưu THEO TENANT trong TenantNotificationConfig.telegramBotToken
# (không đặt ở đây). Hành khách bấm /start với bot rồi nhập số điện thoại để được gắn chat_id.
