DATABASE_URL=postgresql://prod:CHANGE_ME@postgres:5432/passenger_mgmt
# Supabase: DATABASE_URL = Transaction pooler (6543 + ?pgbouncer=true) cho runtime,
#           DIRECT_URL   = Session pooler/Direct (5432) cho `prisma migrate deploy`.
DIRECT_URL=postgresql://prod:CHANGE_ME@postgres:5432/passenger_mgmt
JWT_SECRET=CHANGE_ME_USE_STRONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=production

# Queue (BullMQ): Redis có TLS (Upstash) dùng rediss:// — QueueModule tự bật TLS.
# Chỉ đặt khi BE chạy nền liên tục (Railway/Render). Vercel serverless: để trống (gửi inline).
REDIS_URL=

# Notification providers (optional — leave blank for dev/log mode)
SMS_API_KEY=
SMS_FROM=
BROADCAST_API_KEY=

# EMQX dashboard
EMQX_DASHBOARD_PASSWORD=changeme

# Postgres credentials (must match DATABASE_URL above)
POSTGRES_DB=passenger_mgmt
POSTGRES_USER=prod
POSTGRES_PASSWORD=CHANGE_ME
