# Driver PWA (apps/pwa) — đặt giá trị thật trên Vercel → Project → Settings → Environment Variables.
# Biến VITE_* chỉ áp dụng lúc BUILD; đổi xong phải Redeploy.

VITE_API_URL=        # URL API trên Railway, vd https://your-api.up.railway.app
VITE_WEB_URL=        # URL Admin web trên Vercel, vd https://your-web.vercel.app
