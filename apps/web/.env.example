# Admin web (apps/web) — đặt giá trị thật trên Vercel → Project → Settings → Environment Variables.
# Biến VITE_* chỉ áp dụng lúc BUILD; đổi xong phải Redeploy.

VITE_API_URL=        # URL API trên Railway, vd https://your-api.up.railway.app
VITE_PWA_URL=        # URL PWA tài xế trên Vercel, vd https://your-pwa.vercel.app
